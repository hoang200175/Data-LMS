---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const BOOKS = [
  { href: 'so-tay/phase-1/', title: 'Phase 1: Nền tảng dữ liệu', weeks: 'Tuần 1–3' },
  { href: 'so-tay/phase-2/', title: 'Phase 2: Mô tả', weeks: 'Tuần 4–6' },
  { href: 'so-tay/phase-3/', title: 'Phase 3: Xác suất', weeks: 'Tuần 7–8' },
];
---
<Base title="Sổ tay">
  <h1>Sổ tay tóm tắt</h1>
  <p class="muted">Mỗi phase có một sổ tay ngắn để ôn nhanh trước checkpoint, hoặc in ra mang theo.</p>
  <ul>
    {BOOKS.map((b) => <li><a href={base + b.href}>{b.title}</a> <span class="muted">({b.weeks})</span></li>)}
  </ul>
</Base>
