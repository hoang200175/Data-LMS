---
// Sơ đồ star schema cho dữ liệu bán hàng (Tuần 2).
---
<svg viewBox="0 0 680 300" role="img" aria-label="Star schema cho dữ liệu bán hàng" style="width:100%;max-width:680px;display:block;margin:12px auto" font-family="inherit" font-size="13">
  <g fill="none" stroke="currentColor" stroke-opacity="0.45">
    <line x1="225" y1="150" x2="200" y2="94"/><line x1="225" y1="150" x2="200" y2="206"/>
    <line x1="455" y1="150" x2="480" y2="94"/><line x1="455" y1="150" x2="480" y2="206"/>
  </g>
  <rect x="225" y="90" width="230" height="120" rx="8" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="2"/>
  <text x="340" y="114" text-anchor="middle" font-weight="700" fill="currentColor">FactSales</text>
  <text x="240" y="138" fill="currentColor" font-size="12">Line ID (PK)</text>
  <text x="240" y="156" fill="currentColor" font-size="12">Customer ID, Product ID (FK)</text>
  <text x="240" y="174" fill="currentColor" font-size="12">Order ID, Order Date</text>
  <text x="240" y="192" fill="currentColor" font-size="12">Sales, Quantity, Profit</text>
  <rect x="10" y="30" width="190" height="64" rx="8" fill="var(--surface)" stroke="currentColor" stroke-opacity="0.5"/>
  <text x="24" y="54" font-weight="700" fill="currentColor">DimCustomer</text>
  <text x="24" y="76" fill="currentColor" font-size="12">Customer ID (PK), Segment</text>
  <rect x="10" y="206" width="190" height="64" rx="8" fill="var(--surface)" stroke="currentColor" stroke-opacity="0.5"/>
  <text x="24" y="230" font-weight="700" fill="currentColor">DimProduct</text>
  <text x="24" y="252" fill="currentColor" font-size="12">Product ID (PK), Category</text>
  <rect x="480" y="30" width="190" height="64" rx="8" fill="var(--surface)" stroke="currentColor" stroke-opacity="0.5"/>
  <text x="494" y="54" font-weight="700" fill="currentColor">DimDate</text>
  <text x="494" y="76" fill="currentColor" font-size="12">Date (PK), Tháng, Quý, Năm</text>
  <rect x="480" y="206" width="190" height="64" rx="8" fill="var(--surface)" stroke="currentColor" stroke-opacity="0.5"/>
  <text x="494" y="230" font-weight="700" fill="currentColor">DimRegion</text>
  <text x="494" y="252" fill="currentColor" font-size="12">City (PK), Region</text>
</svg>
